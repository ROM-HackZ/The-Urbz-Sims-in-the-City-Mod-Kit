# Named addresses in The Urbz DS (USA) found by reverse engineering.
# Used by hooks.txt (names instead of numbers) and by C code via game.h.
# Evidence for each is in docs/systems.md.

# --- engine
get_asset          = 0x02032CA8   # void *get_asset(int game_id, int flags, int unpack): loads (once) and returns the asset in RAM
decode_chunk       = 0x0202D83C   # u32 decode_chunk(const u32 *chunk, void *dst): any codec (raw/LZ77/EA), returns size
text_decode        = 0x01FF85C4   # (int string_id, char *buf, int maxlen)  [ITCM]
ea_decompress      = 0x01FF8C50   # (src, dst)                              [ITCM]

# --- game clock
game_time          = 0x0214112C   # game_time_t: the city clock
time_add           = 0x0201D994   # unsigned time_add(game_time_t *t, const game_time_t *delta)
time_update        = 0x02083DB0   # advances game_time by a delta, runs hourly/daily events
time_update_call   = 0x02083DC4   # the BL time_add inside time_update
world_tick         = 0x02084104   # runs once per game tick (30 per second)
time_speed_table   = 0x02113B5C   # game_time_t[]: [0] normal = +3 s per tick, [1] = +60 s
time_speed_index   = 0x021473F8   # u8: which table entry is in use

# --- game state (one big struct of globals at 0x02141120)
game_state         = 0x02141120   # base of the main game-state struct
money              = 0x02141124   # s32 Simoleons (game_state+4); HUD redraws on its own refresh flag
game_phase         = 0x02141C25   # u8 (game_state+0xB05); motives decay only when 3, except Fun
sim_flags          = 0x02141C30   # u16 per-sim flags (x16 entries); bit 2 = motives frozen (tutorial)

# --- motives (needs). Order: 0 hunger, 1 hygiene, 2 energy, 3 social,
#     4 comfort, 5 bladder, 6 fun, 7 room. Values are s32 8.24 fixed point, 0..100.
player_motives     = 0x02141204   # s32[8]
motive_get         = 0x0205DD60   # u8 motive_get(s32 *motives, int i)  -> 0..100
motive_rate        = 0x0205DD70   # s32 per-tick change for motive i (decay tables + modifiers)
motive_decay       = 0x0205E27C   # applies one tick of decay to a motive set
motive_apply_effect= 0x0205DC20   # (s32 *motives, int effect_row, int scale_idx): object/action gains
motive_decay_table = 0x020CEDA8   # s32[8] per-tick change, normal
motive_decay_table_b = 0x020CEDC8 # s32[8] per-tick change when sim+8 != 0 (about 6x faster)
motive_start_table = 0x020CEDE8   # s32[8] new-game starting motives
motive_effect_table= 0x020CEED4   # s32[rows][8] per-tick gains for each action row
motive_effect_scale= 0x020EA998   # s32[] multipliers (1.0, 1.2, 1.4 ...) by object quality

# --- shopping
upgrade_table      = 0x020C25BC   # [category][4 levels] of 12 bytes: s16 price, ...
buy_upgrade        = 0x02018DAC   # pays price, refunds half of the old level
sell_upgrade       = 0x02018D14

# --- save file (8 KB EEPROM: 0x20 header + 2 slots of 0xFE0; see urbz_save.py)
save_ctx           = 0x021470FC   # +0x20 slot buffer, +0x84 write cursor, +0x88 bit, +0x8C bytes used
save_write_bits    = 0x0207E944   # (const u8 *bits, int n)  one bit per input byte
save_write_nibbles = 0x0207E9CC   # (const u8 *vals, int n)  4 bits each
save_write_bytes   = 0x0207EAAC   # (const void *src, int n)
save_serialize_all = 0x020354BC   # writes the whole game into the slot buffer
save_finish_slot   = 0x0207EB28   # serialize + checksum (u16 at +0xFDE)
save_write_slot    = 0x0207E850   # (int slot) EEPROM write
save_read_slot     = 0x0207E87C   # (int slot) EEPROM read
save_slot_valid    = 0x0207E8A8   # (int slot) u16 sum == 0
save_read_bits     = 0x0207EC48   # (u8 *bits, int n)  mirror of save_write_bits
save_read_nibbles  = 0x0207ECBC   # (u8 *vals, int n)
save_read_bytes    = 0x0207ED78   # (void *dst, int n)  byte-aligns the cursor first, like save_write_bytes
save_deserialize_all = 0x020356D8 # reads the whole game from the slot buffer (mirror of save_serialize_all)
save_load_slot     = 0x0207EE00   # reset cursor, deserialize, count bytes (called from area_enter's load mode)
save_game          = 0x0207EBAC   # (int slot) serialize + write + read back + verify (the Save Game screen)
save_boot_init     = 0x0207EE88   # boot: check the header, read both slots (frame ~10, before the title)
save_boot_read_slots = 0x0207E8E8 # boot: read and check both slots
eeprom_read        = 0x02015860   # int (u32 offset, u32 len, void *dst)  cartridge save memory
eeprom_write       = 0x020157D4   # int (u32 offset, u32 len, const void *src)  returns 1 on success; locks the card itself
# hook sites used by the mod core (proven in the emulator 2026-10-02: boot frame 10-15, load and save see
# the cursor go 0 -> 2,569 bytes on city.sav). The game never writes save memory 0x1FE0-0x1FFF (0xFF on a real save).
save_boot_read_call = 0x0207EF00  # BL save_boot_read_slots in save_boot_init
save_serialize_call = 0x0207EB44  # BL save_serialize_all in save_finish_slot (slot buffer zeroed just before)
save_deserialize_call = 0x0207EE1C # BL save_deserialize_all in save_load_slot
world_tick_call    = 0x0204C06C   # the only BL world_tick (city update 0x0204C014)
area_enter_last_call = 0x0204C58C # last BL in area_enter (to 0x0204B19C), after the area and its people are set up
area_enter_finish  = 0x0204B19C
game_start         = 0x0204BA98   # first city entry after the title: loads the slot (load modes) or sets up a new game; runs once
game_start_call    = 0x0204C268   # the BL game_start in area_enter
new_game_init      = 0x02035C48   # new-game setup (seen once, from game_start, in a new game; not on a load)
# NitroSDK cache maintenance (r0 = address, r1 = size)
DC_FlushRange      = 0x020B7C70
DC_WaitWriteBufferEmpty = 0x020B7C8C
IC_InvalidateRange = 0x020B7C98

# --- people
talk_partner       = 0x021474F8   # u32 index of the character being talked to; name string = 481 + index

# --- people / NPCs. Character ids: 31 + c, where c = 0..35 is the person in name order
#     (name string 512 + c, bio 471 + c): 31 Bayou Boo ... 45 Kris Thistle ... 66 Sharona Faster.
current_area       = 0x02141FEC   # u32 id of the area (lot/street) on screen
npc_present        = 0x02065AD0   # bool npc_present(int char_id, int area, game_time_t *t)
npc_schedule_table = 0x020E4FD8   # u8 *[char_id - 31]: u8[24 hours][7 weekdays] = area id (0 = no table)
npc_busy_list      = 0x02142270   # 10 x {s16 active, u8 char_id, ...} (6 bytes): these NPCs are away
spawn_npc          = 0x0206499C   # entity *spawn_npc(int char_id, int facing, int x<<16, int y<<16)
spawn_from_record  = 0x02064ED8   # area placement record {u16 type 7, u16, s16 x, s16 y, u8 char, u8 facing}
relationships      = 0x02141154   # 36 x 4 bytes: [0] s8 relationship with person c (-128 = never met)

# --- entities (people and objects on screen): pool of 0x148-byte structs from 0x0215E344.
#     +0x08 u16 type (0 player, 7 person), +0x0A u16 character id, +0x0C flags,
#     +0x18/+0x1C x/y (16.16), +0x4C behaviour function, +0x104 u8 state, +0x105 u8 action,
#     +0xC7 u8 animation, +0x146 u16 character id
entity_new         = 0x020062EC   # entity *entity_new(int type)
entity_set_state   = 0x02000E20   # (e, state)   +0x104
entity_set_action  = 0x02000E54   # (e, action)  +0x105
entity_play_anim   = 0x02000F34   # (e, anim)    player: 0x02037908, people: 0x020647E0
motive_failure     = 0x0205DEB8   # a need at 0 starts its failure action (accident, pass out...)
room_motive_tick   = 0x02083CB8   # pulls Room toward the area's score (rows 39/41)

# --- buyable objects (catalog). Index i is the same in both tables, 0x14 bytes per row.
object_text_table  = 0x020E6D48   # {u32 model id, u32 description string, u32 name string, u32 catalog page, u32 ?}
object_info_table  = 0x020E8B70   # {u32 price, u32 flags, ...}; e.g. i=200 "The Savvy Shower" $230

# --- stats, jobs
add_stat           = 0x02035350   # u32 add_stat(int kind, int delta): 0/1 = u16 counters at 0x02141B88/0x02141B86, 2 = money (max 999,999; refreshes the HUD)
money_max          = 999999
job_session_ptr    = 0x021420D0   # -> current job shift: +4 s16 Simoleons earned this shift, +0x11 job, +0x12 level
job_pay_call       = 0x020516AC   # BL add_stat(2, earned) when a shift ends
schedule_lookup    = 0x02065890   # u8 schedule_lookup(int char_id, game_time_t *t): area this person should be in (82 = out of town)
npc_relocate_tick  = 0x02066110   # every 150 ticks: people whose schedule says this area walk in, others walk out
schedule_lookup_call = 0x0206665C # the BL schedule_lookup inside npc_relocate_tick (hook point for NPC Life)
npc_present        = 0x02065AD0   # bool npc_present(id, area, time): quest overrides, busy list, date partner, then the schedule table
schedules_on       = 0x02142234   # u8: 0 = everyone always present (very start of a new game), 1 = schedules apply
npc_busy_list      = 0x02142270   # 10 x 6 bytes {s16 timer, u8 id, u8 area, u8 zone key, u8 state}: visits placed in a spawn zone; npc_present keeps them off their schedule
# literal pool words that hold &npc_schedule_table (npc_present reads the table directly, not via schedule_lookup)
schedule_table_ptr_1 = 0x02065888
schedule_table_ptr_2 = 0x02065924
schedule_table_ptr_3 = 0x02065AA0
schedule_table_ptr_4 = 0x0206610C
schedule_table_ptr_5 = 0x02066700

# --- goals (quests): 7 missions x 6 goals x 12 bytes; m = mission 0-6 (Goals menu 1-5, S, R), g = goal 0-5
goal_table         = 0x02141940   # +0 u8 active, +1 u8 complete (set when you report back), +2+2s u8 sub-goal s shown, +3+2s u8 sub-goal s done
goal_active        = 0x02054334   # u8 goal_active(m, g)
goal_complete      = 0x020542F4   # u8 goal_complete(m, g)
subgoal_done       = 0x02054314   # u8 subgoal_done(m, g, s)
subgoal_shown      = 0x02054354   # u8 subgoal_shown(m, g, s)
relationship_base  = 0x02141134   # social table: relationships = base + 0x20
add_relationship   = 0x0207B074   # int add_relationship(base, char_id, delta): clamps -100..100, sets friend flags at 50

# --- areas (docs/areas.md). Area ids 0-79; name string = 975 + id; 82 = out of town
area_table         = 0x020C87E0   # 80 x 0x14: {ptr, u32 name string, u32 data asset game id, u8[4], u32}
area_gfx_table     = 0x020C8E20   # 80 x 0x50: graphics asset ids per area
area_entry_point   = 0x02141C28   # u8 entry point used when an area loads
area_variant       = 0x02122794   # u8 story variant: picks the area data section (0 tutorial, 1 after the first job)
area_enter         = 0x0204C158   # loads the area in current state param, spawns record groups 0 and 1
set_state          = 0x0204DF7C   # set_state(state, mode, param): doors call set_state(1, 0, area)
record_handlers    = 0x020C2308   # area record type -> create function (7 person, 3 door, 25 elevator, 29 NPC way point, 30 spawn zone)
spawn_record_group = 0x020125C0   # spawn one record group of the current area (0 and 1 at area load)
swap_record_groups = 0x02012690   # swap_record_groups(show, hide): scripts and objects switch groups 2+
npc_walk_out       = 0x020655C0   # person heads for the type-29 way point toward their next area
npc_walk_in        = 0x020656A4   # person appears on a type-29 way point (facing 4)
spawn_in_zone      = 0x020644FC   # spawn_in_zone(id, key): random spot in the type-30 zone with that key

# --- player look (docs/player-look.md)
player_look        = 0x02141144   # u8[10]: gender, skin, hair style, hair colour, shirt style, shirt, overshirt, sleeve, pants, shoes colour
cab_hair_tables    = 0x0211CDAC   # Create-a-Bod hair part tables per gender -> u32[4 styles]
city_hair_tables   = 0x020F75D0   # city player hair tables per gender -> u32[4 styles] -> anim table u32[196]
build_player_palette = 0x02083538 # builds the player's 2 OBJ rows from assets 11543 (skin/hair/shoes) and 11542 (clothes)

# --- palettes and fonts
npc_palette_table  = 0x020D0054   # u32 palette game id per character id (Kris 45 -> file 09160)
street_palette_table = 0x020C82C4 # u32 game ids loaded into OBJ rows 2-8 on streets
set_palette_row    = 0x0206D84C   # void set_palette_row(entity, row): entity+0x90 bits 12-15 (row 0xFF = leave it)
load_palette_row   = 0x0206D73C   # people: take a free/shared row from the pool and load a 16-colour palette into it
obj16_rows         = 0x020C2828   # u32[5]: OBJ palette row per variant for area record type 16 (pick-ups)
obj16_sprites      = 0x020C2838   # 5 x {gfx, layout, palette, param} sprite records for record type 16
obj31_rows         = 0x020C2B08   # u32[6]: OBJ palette row per variant for area record type 31
font_table         = 0x020C5CEC   # 8 x {u32 font game id, u32 colour base}
font_descriptors   = 0x02140D60   # 8 x 0x28 resident font descriptors

# --- bottom-screen menus (Urb Info / Options / globe ...; docs/systems.md "Menus")
menu_table_ptrs    = 0x020F5654   # menu *[5]: 0 globe?, 1 catalog pages, 2 Options (0x020F56EC), 3 ?, 4 Urb Info... (index = menu_ui+8)
options_menu       = 0x020F56EC   # header {u32 gfx, u32 layout, 0, 0, u32 pal16, u32 pal256, u16 count, u16} + count x 20-byte buttons
menu_ptr_lit_1     = 0x0206FD54   # literal pool words holding &menu_table_ptrs (the only references)
menu_ptr_lit_2     = 0x020701B4
menu_ptr_lit_3     = 0x020703B0
menu_ptr_lit_4     = 0x020706BC
menu_ui            = 0x02144CEC   # -> {+4 open, +8 menu index, +0xC action, +0x10 selected button}
menu_hit_test      = 0x0206FBF4   # int (): touched button -> its action (0 = open sub-menu index in word 3, then -1); -1 = none
menu_hit_call      = 0x0206FDAC   # the only BL menu_hit_test
menu_redraw        = 0x0207026C   # rebuild the open menu's icons and text
menu_draw_text     = 0x02070038   # title + one label per button
menu_label_call    = 0x0207016C   # BL text_get(button label id) in menu_draw_text
menu_dispatch      = 0x02070494   # run the chosen action (6 settings, 7 save, 0x28 quit, ...)
text_get           = 0x020A6D28   # const char *text_get(int string_id)
text_draw          = 0x020340F8   # (int tiles, int x, int y, const char *s, int align: 1 centre x, 2 right, 4 centre y)
text_width         = 0x0203458C   # int (const char *s): width in pixels with the current font
text_font          = 0x02034754   # (int font, int colour, -1): font slot for the following text_draw calls
ui_sound           = 0x02097B58   # (int id): 1 select, 3 refused, 4 open sub-menu
touch_state        = 0x02141D70   # +0x0E u16 x, +0x10 u16 y, +0x52 u16 touched this frame


# --- people: movement and object use (Phase 6)
npc_state_dispatch = 0x0200BE50   # (e): switch on e+0x104 (state) -> handler; 0x22 walk out, 0x23 wander, 0x26 go to object
npc_wander_state   = 0x0200A1F0   # state 0x23: action 7 stand (timer +0x108), 0x19 walk a random line, 0x29 gesture, 0x2d path to e+0x38, 0x3e use an object
npc_goto_object_state = 0x0200D584 # state 0x26: path result +0x10b: 1 arrived -> object starts activity +0x122, 3 failed -> action 0x13 (back to e+0x10a state)
npc_pick_object    = 0x02008A18   # int (e, &obj_entity, &activity): object in this area whose activity serves a need (mask 0x76) below 31; needs e+0x114
npc_use_object     = 0x02067C68   # int (obj_entity, person, activity): checks, then npc_goto_object
npc_goto_object    = 0x0200D720   # int (person, obj_entity, activity): use spot, path there, state 0x26, action 3, anim 0x0A
npc_can_use_objects = 0x02066960  # u8 (id): person record +0x36 (only 33 39 41 52 54 58 in the original)
npc_record         = 0x02066858   # (id): 0x38-byte record, table 0x020E5E5C (+0x36 = may use objects)
path_request       = 0x0207DC08   # int (e, s32 xy[2] (16.16), u8 *result, 0): 3 slots (0x02146F1C, 0xA0 each); result 2 walking, 1 arrived, 3 failed
path_cancel        = 0x0207DB10   # (e): frees e's path slot
object_class_table = 0x020EAF84   # 0x24 bytes per object number: +4 list activities, +8 can start, +0xC start, +0x1C usable by
object_list_head   = 0x0214490C   # first node of this area's objects: {next, ?, u16 object number @+8, ..., entity @+0x24}
activity_need_table = 0x020EA9B0  # u32 per activity: which need it serves (u16)
entity_lists       = 0x02121AF0   # {u32 head, u32 first} per context (8 bytes); context 0 = the world (people, objects); entity +0 = next
path_count         = 0x02146F18   # u8 path slots in use (of 3); npc_goto_object does not check, so check first
npc_end_activity   = 0x02000D70   # (e, activity record): drops it from e+0x100 (no clean-up; prefer the stop byte)
entity_face        = 0x02000F08   # (e, dir 1-8): clockwise, 8 = up (screen), 3 = down-right, 7 = up-left
npc_has_anim       = 0x020644A8   # int (id, anim): in the person's animation list (0x0211CDF4, 12-byte rows, ends 0xC4)
npc_anim_lists     = 0x0211CDF4   # u8 *[id]: {u8 anim, ...} x 12 bytes; 0x6B sit / 0x7B toilet only for 33 39 41 45 52 53 54 58
player_body_setup  = 0x0208327C   # (e, look): fills drawing slots 0-3 (+0xCC, 12 bytes: +1 palette row, +8 anim table) from the look, index e+0xC7
load_look_palette  = 0x020833E0   # (look, row_a, row_b): builds the player's 2 palette rows from a look into OBJ rows a (skin/hair) and b (clothes)
entity_set_frames  = 0x02003130   # (e, anim, facing record): picks the facing's records (player: facing from player_facing_table[e+0x12])
entity_set_script  = 0x02002B68   # (e, frame script, start): the animation's frame sequence (+0xA0)
player_gfx_refresh = 0x020374B8   # the player's graphics update: body setup, frames, script when e+0x106 & 0x14
player_facing_table = 0x020C22B4  # s8 per direction (0x020C22C8 when e+0xC bit 29 is set)
player_scripts_a   = 0x021204EC   # u32[anim] frame scripts (game_state+0x24 == 0)
player_scripts_b   = 0x0211EC5C   # u32[anim] frame scripts (game_state+0x24 != 0)
player_body_tables = 0x020F75E0   # u32[gender] -> u32[196] body anim tables (0 = no such animation)
entity_layered     = 0x020031F4   # (e): e+0xC5 |= 0x40 (draw from 4 slots, like the player) and resets the slots (+0xD2 = 0xFFFF: no sprite memory yet)
asset_load         = 0x02032B08   # int (game id, unpack): loads into asset_ptrs; ids >= the count literal are refused
asset_offsets      = 0x0212352C   # u32[13386]: rom.bin's index (read at boot); moved by urbz_build when mods add assets
asset_ptrs         = 0x02130654   # u32[13386]: where each loaded asset is (0 = not loaded)
asset_refs         = 0x0213D77C   # u8[13386]: use counts
